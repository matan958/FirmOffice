# Copy to .env.local and fill from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration
#
# These are PUBLIC values — they identify the project, they do not authorize access.
# Access is controlled by security rules and custom claims. Do not put secrets here;
# server-side secrets (Gmail refresh token, WhatsApp tokens) live in Secret Manager.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SPA at the local emulator suite instead of the real project.
# Leave "true" for day-to-day development; never set it in a production build.
VITE_USE_EMULATORS=true
